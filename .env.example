# Телеграм
CERT_BOT_TOKEN=          # токен от @BotFather
CERT_ADMINS=             # пусто — доступ у всех; иначе chat_id через запятую

# Сертификаты
CERT_VERIFY_URL=https://capedu.kz/verify.html?id={code}

# Google-таблица «KPI Куратор 2026», лист «Оффбординг»
CERT_SHEET_ID=           # id из адреса: /spreadsheets/d/<id>/edit

# Альфа-CRM
ALFA_HOST=               # например: myschool.s20.online
ALFA_EMAIL=              # email пользователя с доступом к API
ALFA_API_KEY=            # ключ API (v2api) из профиля
ALFA_BRANCH=1            # id филиала: /company/<id>/

# Запасной путь к таблице через Apps Script (нужен, только если нет OAuth)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
